# Required in any non-local deployment; generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
# Set a strong unique secret before starting. Never commit a real .env file.
DEVELOPER_PASSWORD=change-this-outside-source-control
# Local development: false. Use true behind HTTPS in production.
COOKIE_SECURE=false
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional overrides
# DATABASE_PATH=backend/app.db
# MODEL_PATH=backend/saved_models/active_model.joblib
